<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Freund | Panel administrativo</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #f1f5f9;
      font-family: Arial, sans-serif;
      color: #0f172a;
    }
    header {
      background: #1d4ed8;
      color: white;
      padding: 20px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    main { max-width: 1000px; margin: 35px auto; padding: 0 20px; }
    .card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      margin-bottom: 22px;
      box-shadow: 0 3px 15px #0001;
    }
    input {
      padding: 11px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      margin: 5px;
    }
    button {
      padding: 11px 17px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    table { width: 100%; border-collapse: collapse; }
    th, td {
      padding: 13px;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
    }
    th { background: #f8fafc; }
    #mensaje { color: #b91c1c; }
  </style>
</head>
<body>
  <header>
    <strong>Freund | Administración</strong>
    <button id="salir">Cerrar sesión</button>
  </header>

  <main>
    <h1>Panel de productos</h1>
    <p>Node.js + Express + PostgreSQL | Kubernetes PaaS</p>

    <div class="card">
      <h2>Registrar producto</h2>
      <form id="productoForm">
        <input name="nombre" placeholder="Nombre del producto" required>
        <input name="precio" type="number" step="0.01"
               min="0" placeholder="Precio ($)" required>
        <button type="submit">Guardar producto</button>
      </form>
      <p id="mensaje"></p>
    </div>

    <div class="card">
      <h2>Productos registrados</h2>
      <table>
        <thead>
          <tr><th>ID</th><th>Producto</th><th>Precio</th></tr>
        </thead>
        <tbody id="productos"></tbody>
      </table>
    </div>
  </main>

  <script>
    async function comprobarSesion() {
      const res = await fetch("/api/session");
      if (!res.ok) {
        window.location.replace("/");
        return false;
      }
      return true;
    }

    async function cargarProductos() {
      const res = await fetch("/api/productos");
      if (res.status === 401) {
        window.location.replace("/");
        return;
      }
      if (!res.ok) throw new Error("No se pudieron cargar productos");

      const productos = await res.json();
      const tabla = document.getElementById("productos");
      tabla.replaceChildren();

      productos.forEach(p => {
        const fila = document.createElement("tr");
        const id = document.createElement("td");
        const nombre = document.createElement("td");
        const precio = document.createElement("td");

        id.textContent = p.id;
        nombre.textContent = p.nombre;
        precio.textContent = "$" + Number(p.precio).toFixed(2);

        fila.append(id, nombre, precio);
        tabla.appendChild(fila);
      });
    }

    document.getElementById("productoForm")
      .addEventListener("submit", async (e) => {
        e.preventDefault();

        const form = new FormData(e.target);
        const res = await fetch("/api/productos", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(form))
        });

        const data = await res.json();

        if (res.ok) {
          e.target.reset();
          document.getElementById("mensaje").textContent = "";
          await cargarProductos();
        } else {
          document.getElementById("mensaje").textContent =
            data.error || "Error al guardar";
        }
      });

    document.getElementById("salir")
      .addEventListener("click", async () => {
        await fetch("/api/logout", { method: "POST" });
        window.location.replace("/");
      });

    (async () => {
      if (await comprobarSesion()) {
        try {
          await cargarProductos();
        } catch (e) {
          document.getElementById("mensaje").textContent = e.message;
        }
      }
    })();
  </script>
</body>
</html>
